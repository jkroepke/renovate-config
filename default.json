{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "labels": ["🛠️ dependencies"],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 5"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "configMigration": true,
  "dockerMaxPages": 10,
  "gitIgnoredAuthors": [
    "210774419+jkroepke-automation[bot]@users.noreply.github.com"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "enabled": true,
      "matchFileNames": ["charts/**"],
      "commitMessagePrefix": "[{{ lookup (split packageFileDir '/') 1 }}] ",
      "groupName": "{{ lookup (split packageFileDir '/') 1 }} dependency non-major updates",
      "separateMajorMinor": true,
      "postUpdateOptions": ["helmUpdateSubChartArchives"],
      "major": {
        "groupName": "{{ lookup (split packageFileDir '/') 1 }} dependency major updates"
      },
      "matchPackageNames": ["*"],
      "bumpVersions": [
        {
          "name": "Updating Chart version",
          "filePatterns": [
            "/^(?:{{#each (distinct (lookupArray upgrades \"packageFileDir\"))}}{{#each (split . \"/\")}}(?:{{{.}}}/{{/each}}{{#each (split . \"/\")}}){{#unless @last}}?{{/unless}}{{/each}}{{#unless @last}}|{{/unless}}{{/each}})Chart\\.ya?ml$/"
          ],
          "matchStrings": [
            "(?:^|\\n)version:\\s\"?(?<version>([1-9]\\d*|\\d+\\.[1-9]\\d*|\\d+\\.\\d+\\.[1-9]\\d*)\\.\\d+\\.\\d+)\"?(?:$|\\n)"
          ],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "major": {"enabled": false},
      "enabled": true
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["!/github-runners$/"],
      "semanticCommitScope": "github-actions",
      "separateMajorMinor": false,
      "labels": ["chore"]
    },
    {
      "groupName": "GitHub Runners",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-runners"],
      "semanticCommitScope": "github-actions",
      "separateMajorMinor": false,
      "labels": ["chore"]
    },
    {
      "groupName": "golangci-lint",
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/cmd/golangci-lint",
        "golangci/golangci-lint",
        "golangci/golangci-lint-action"
      ],
      "labels": ["chore"]
    },
    {
      "enabled": true,
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump"
    },
    {
      "enabled": true,
      "matchDepNames": ["go", "golang"],
      "groupName": "go version"
    },
    {
      "enabled": true,
      "matchCategories": ["go"],
      "matchUpdateTypes": ["digest"]
    },
    {
      "groupName": "moby monorepo",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/moby/moby", "github.com/moby/moby/**"]
    },
    {
      "groupName": "golang.org/x",
      "matchPackageNames": ["golang.org/x/**"],
      "sourceUrl": "https://github.com/golang/{{{lookup (split packageName '/') 2}}}"
    },
    {
      "groupName": "googleapis",
      "matchPackageNames": ["google.golang.org/genproto/googleapis/**"]
    },
    {
      "groupName": "Go tools",
      "matchFileNames": ["tools/**", "Makefile"],
      "matchPackageNames": ["*"],
      "labels": ["chore"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/./"],
      "matchStrings": [
        "[\\t ]*(?:#|//) ?renovate: (?<datasource>git-refs)=(?<depName>\\S+)(?: branch=(?<currentValue>\\S+))?[\\t ]*\\r?\\n.+?[:=][\\t ]*[\"']?(?<currentDigest>[a-f0-9]+)[\"']?",
        "[\\t ]*(?:#|//) ?renovate: (?<datasource>[^=]+)=(?<depName>\\S+)(?: registry=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?[\\t ]*\\r?\\n.+?[:=][\\t ]*[\"']?(?<currentValue>[^@\\s\"'=]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else if (equals datasource 'git-refs')}}main{{/if}}",
      "datasourceTemplate": "{{#if (equals datasource 'github')}}github-tags{{else}}{{{datasource}}}{{/if}}",
      "versioningTemplate": "{{#if (equals datasource 'docker')}}docker{{else if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/Makefile/"],
      "matchStrings": ["go run (?<depName>\\S+)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/).+\\.ya?ml$/"],
      "matchStrings": [
        "[\\t ]*image:[\\t ]*\\r?\\n[\\t ]*registry:[\\t ]*[\"']?(?<registry>.*?)[\"']?[\\t ]*\\r?\\n[\\t ]*(?:repository|name):[\\t ]*[\"']?(?<repository>.*?)[\"']?[\\t ]*\\r?\\n[\\t ]*tag:[\\t ]*[\"']?(?<currentValue>[\\w\\.+-]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?",
        "[\\t ]*image:[\\t ]*[\"']?(?:(?<registry>[^\\s/\"']+[.:][^\\s/\"']+|localhost)/)?(?<repository>[^\\s:@\"']+):(?<currentValue>[\\w.+-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "depNameTemplate": "{{#if registry}}{{{registry}}}/{{/if}}{{{repository}}}",
      "datasourceTemplate": "docker"
    }
  ]
}
